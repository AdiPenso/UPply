# Copy this file to `.env` and fill in the values from your AWS account.
# All three are required for the client to start.

# Amazon Cognito User Pool  (Cognito console -> User pools -> your pool)
VITE_COGNITO_USER_POOL_ID=YOUR_USER_POOL_ID
VITE_COGNITO_USER_POOL_CLIENT_ID=YOUR_USER_POOL_CLIENT_ID

# API Gateway base URL  (API Gateway console -> your API -> Stages)
VITE_API_BASE_URL=https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com
